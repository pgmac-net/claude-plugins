{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pgmac-net/claude-plugins/plugins/sre-harness/schemas/openslo.schema.json",
  "title": "OpenSLO v1 SLO, as supported by sre-harness",
  "description": "The subset of OpenSLO v1 the harness turns into recording rules: one SLO per file, a rolling window, one objective, an inline ratio indicator on a Prometheus-compatible source. Harness settings are annotations under metadata.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "openslo/v1"
    },
    "kind": {
      "const": "SLO"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "annotations"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "displayName": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "required": [
            "sre-harness/journey"
          ],
          "properties": {
            "sre-harness/journey": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "description": "Name of the journey file (without .md) this SLO measures."
            },
            "sre-harness/budget": {
              "enum": [
                "true",
                "false"
              ],
              "description": "\"false\" records the SLI and attainment but gives it no error-budget state."
            },
            "sre-harness/expected-interval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*[sm]$",
              "description": "For a gauge indicator (counter: false): how often a sample is expected. Within a five-minute window only reported samples count, so scrape jitter is not failure; a prober silent for a whole window counts as failing."
            }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "service",
        "budgetingMethod",
        "timeWindow",
        "objectives",
        "indicator"
      ],
      "properties": {
        "service": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Catalog name of the Component this SLO belongs to."
        },
        "description": {
          "type": "string"
        },
        "budgetingMethod": {
          "const": "Occurrences"
        },
        "timeWindow": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "duration",
              "isRolling"
            ],
            "properties": {
              "duration": {
                "type": "string",
                "pattern": "^[1-9][0-9]*[hd]$"
              },
              "isRolling": {
                "const": true
              }
            }
          }
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "target"
            ],
            "properties": {
              "displayName": {
                "type": "string"
              },
              "target": {
                "type": "number",
                "minimum": 0.9,
                "maximum": 0.99999
              }
            }
          }
        },
        "indicator": {
          "type": "object",
          "required": [
            "metadata",
            "spec"
          ],
          "properties": {
            "metadata": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              }
            },
            "spec": {
              "type": "object",
              "required": [
                "ratioMetric"
              ],
              "properties": {
                "ratioMetric": {
                  "type": "object",
                  "required": [
                    "counter",
                    "good",
                    "total"
                  ],
                  "properties": {
                    "counter": {
                      "type": "boolean"
                    },
                    "good": {
                      "$ref": "#/$defs/source"
                    },
                    "total": {
                      "$ref": "#/$defs/source"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "metricSource"
      ],
      "properties": {
        "metricSource": {
          "type": "object",
          "required": [
            "type",
            "spec"
          ],
          "properties": {
            "type": {
              "const": "Prometheus"
            },
            "spec": {
              "type": "object",
              "required": [
                "query"
              ],
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A plain series selector, metric{labels}. The harness adds rate() or sum_over_time() itself."
                }
              }
            }
          }
        }
      }
    }
  }
}
