{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pgmac-net/claude-plugins/plugins/sre-harness/schemas/autonomy.schema.json",
  "title": "sre-harness pre-approved actions",
  "description": "The allow-list of Tier 2 actions: mutations an agent may run during an incident without asking. Nothing is Tier 2 unless it is listed here. Changed only by reviewed pull request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tier2_enabled",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tier2_enabled": {
      "type": "boolean",
      "description": "Site-wide switch. False makes every action Tier 1."
    },
    "disabled_services": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^component:[a-z0-9][a-z0-9-]*$"
      },
      "description": "Services whose actions are suspended, for example while an error budget is exhausted."
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "service",
          "command",
          "precondition",
          "max_per_incident"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "service": {
            "type": "string",
            "pattern": "^component:[a-z0-9][a-z0-9-]*$"
          },
          "runbook": {
            "type": "string",
            "description": "Runbook file this step comes from, relative to the runbooks directory."
          },
          "step": {
            "type": "string",
            "description": "Which step of that runbook."
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "description": "The exact command, as one simple command with no shell operators. Variable parts are {name} placeholders, each defined under parameters."
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Regular expression the whole value must match."
                }
              }
            }
          },
          "precondition": {
            "type": "string",
            "minLength": 1,
            "description": "What must be true before running it. The agent must confirm this from evidence."
          },
          "max_per_incident": {
            "type": "integer",
            "minimum": 1
          },
          "enabled": {
            "type": "boolean",
            "description": "Default true."
          }
        }
      }
    }
  }
}
