{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pgmac-net/claude-plugins/plugins/sre-harness/schemas/stpa.schema.json",
  "title": "sre-harness STPA analysis front matter",
  "description": "One STPA (System-Theoretic Process Analysis) of one service: losses, hazards, the control structure, unsafe control actions and loss scenarios. Cross-references are checked by stpa.py, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "service", "status", "reviewed", "losses", "hazards", "controllers", "processes", "control_actions", "feedback", "ucas", "scenarios"],
  "$defs": {
    "text": {"type": "string", "minLength": 3},
    "refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "evidence": {
      "type": "array",
      "description": "Where the claim comes from: a PIR, runbook, issue or file path, optionally with a line.",
      "items": {"type": "string", "minLength": 3},
      "uniqueItems": true
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "service": {"type": "string", "pattern": "^component:[a-z0-9][a-z0-9-]*$", "description": "The catalog Component analysed."},
    "status": {"enum": ["draft", "reviewed"], "description": "reviewed: a person has gated every step. Only a reviewed analysis counts as current."},
    "reviewed": {"type": "string", "format": "date", "description": "Date of the last full review. PIRs after it make the analysis due again."},
    "scope": {"type": "string", "description": "What is inside the boundary, and what is not."},
    "losses": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "text"],
        "properties": {"id": {"type": "string", "pattern": "^L-[0-9]+$"}, "text": {"$ref": "#/$defs/text"}}
      }
    },
    "hazards": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "text", "losses"],
        "properties": {
          "id": {"type": "string", "pattern": "^H-[0-9]+$"},
          "text": {"$ref": "#/$defs/text"},
          "losses": {"$ref": "#/$defs/refs"}
        }
      }
    },
    "controllers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "responsibilities"],
        "properties": {
          "id": {"type": "string", "pattern": "^C-[0-9]+$"},
          "name": {"$ref": "#/$defs/text"},
          "kind": {"enum": ["human", "automated", "software"], "description": "automated: acts with no person in the loop (self-heal, controller loop). software: a system that acts on request."},
          "responsibilities": {"type": "array", "items": {"$ref": "#/$defs/text"}, "minItems": 1},
          "process_model": {"type": "array", "items": {"$ref": "#/$defs/text"}, "description": "What the controller believes about the process; flaws here cause unsafe actions."},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "processes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name"],
        "properties": {"id": {"type": "string", "pattern": "^P-[0-9]+$"}, "name": {"$ref": "#/$defs/text"}}
      }
    },
    "control_actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "action"],
        "properties": {
          "id": {"type": "string", "pattern": "^CA-[0-9]+$"},
          "from": {"type": "string", "pattern": "^C-[0-9]+$"},
          "to": {"type": "string", "pattern": "^(C|P)-[0-9]+$"},
          "action": {"$ref": "#/$defs/text"}
        }
      }
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "signal", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^F-[0-9]+$"},
          "from": {"type": "string", "pattern": "^(C|P)-[0-9]+$"},
          "to": {"type": "string", "pattern": "^C-[0-9]+$"},
          "signal": {"$ref": "#/$defs/text"},
          "status": {"enum": ["present", "inadequate", "missing"], "description": "missing: the controller needs this signal and has none."},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "ucas": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "action", "type", "context", "hazards"],
        "properties": {
          "id": {"type": "string", "pattern": "^UCA-[0-9]+$"},
          "action": {"type": "string", "pattern": "^CA-[0-9]+$"},
          "type": {"enum": ["not-provided", "provided-unsafe", "wrong-timing", "wrong-duration"], "description": "The four STPA guidewords: not provided; provided and unsafe; too early, too late or out of order; stopped too soon or applied too long."},
          "context": {"$ref": "#/$defs/text"},
          "hazards": {"$ref": "#/$defs/refs"},
          "evidence": {"$ref": "#/$defs/evidence"},
          "hypothesised": {"type": "boolean", "description": "true when no evidence exists yet; the analysis says so rather than inventing a citation."}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "ucas", "text", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^LS-[0-9]+$"},
          "ucas": {"$ref": "#/$defs/refs"},
          "text": {"$ref": "#/$defs/text"},
          "causal_factors": {"type": "array", "items": {"enum": ["inadequate-control-algorithm", "flawed-process-model", "missing-feedback", "inadequate-feedback", "actuator-failure", "conflicting-controllers", "process-disturbance", "human-factors"]}, "uniqueItems": true},
          "status": {"enum": ["controlled", "uncontrolled"], "description": "controlled: a working control or feedback exists today, named in 'control'. uncontrolled: a finding."},
          "control": {"type": "string", "description": "The control or feedback that handles this scenario today."},
          "finding": {"type": "string", "pattern": "^https://[^\\s]+/(issues|pull)/[0-9]+$", "description": "The issue that tracks an uncontrolled scenario."},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "proposed": {
      "type": "array",
      "description": "UCAs or loss scenarios proposed by a CAST section of a PIR, waiting for the next review. Any entry here makes the analysis due.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "text", "source"],
        "properties": {
          "kind": {"enum": ["uca", "scenario", "feedback", "controller"]},
          "text": {"$ref": "#/$defs/text"},
          "source": {"type": "string", "minLength": 3, "description": "The PIR that proposed it."}
        }
      }
    }
  }
}
