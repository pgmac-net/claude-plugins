#!/bin/sh
# post-merge: clear local incident state whose audit log has now merged.
#
# Git runs this after a pull brings changes in. It is one trigger among three
# (the others: `incident.py open`, which clears old state at the start of the
# next incident, and `incident.py gc --apply` by hand). It is best effort and
# never makes a pull fail: whatever happens here, it exits 0.
#
# What is deleted, and why that is safe, is decided by `incident.py gc`: only
# an incident whose audit file on the fetched default branch is byte-identical
# to the local copy, and whose tracking issue is closed. See the sre-harness
# README, "Cleaning up local state".
#
# INSTALL by copying, not by pointing git at the repository's own directory:
#
#     cp .githooks/post-merge "$(git rev-parse --git-path hooks)/post-merge"
#     git config sre-harness.plugin /path/to/plugins/sre-harness
#
# A copy in .git/hooks cannot be changed by a pull. A hook run straight from the
# tracked directory (core.hooksPath) executes whatever the last pull brought in.
# Re-copy it when you update the plugin and want a newer hook.
#
# The plugin directory is read only from SRE_HARNESS_PLUGIN or the per-clone
# `sre-harness.plugin` setting above, never guessed, and never taken from the
# repository's contents. With neither set, the hook does nothing.

plugin="${SRE_HARNESS_PLUGIN:-$(git config --get sre-harness.plugin 2>/dev/null)}"
script="$plugin/scripts/incident.py"
[ -n "$plugin" ] && [ -f "$script" ] || exit 0
command -v uv >/dev/null 2>&1 || exit 0
site=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# Run from the plugin directory, ignoring any uv configuration: the repository's
# own files (uv.toml, pyproject.toml) must not influence what runs.
(
    cd "$plugin" &&
        SRE_HARNESS_SITE="$site" uv run --no-config --no-project "$script" gc --apply --no-fetch --quiet
) >/dev/null 2>&1 || true
exit 0
