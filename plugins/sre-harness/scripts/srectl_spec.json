                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": "<repo-alias>-<number>"
            }
          ]
        },
        "run": {
          "help": "match and execute",
          "options": [
            {
              "flags": [
                "--command"
              ],
              "value": true,
              "choices": null,
              "help": "the exact command"
            },
            {
              "flags": [
                "--service"
              ],
              "value": true,
              "choices": null,
              "help": "the service being acted on, as component:<name>"
            },
            {
              "flags": [
                "--precondition-evidence"
              ],
              "value": true,
              "choices": null,
              "help": "what you observed that satisfies the precondition"
            },
            {
              "flags": [
                "--timeout"
              ],
              "value": true,
              "choices": null,
              "help": "seconds before the command is abandoned"
