{
  "spec": 1,
  "entries": {
    "incident": {
      "script": "incident.py",
      "help": "Open, update and close the record of an incident.",
      "options": [
        {
          "flags": [
            "--site"
          ],
          "value": true,
          "choices": null,
          "help": "site repository path"
        }
      ],
      "required": true,
      "commands": {
        "open": {
          "help": "create the tracking issue",
          "options": [
            {
              "flags": [
                "--title"
              ],
              "value": true,
              "choices": null,
              "help": ""
            },
            {
              "flags": [
                "--severity"
              ],
              "value": true,
              "choices": [
                "P1",
                "P2",
                "P3",
                "P4"
              ],
              "help": "provisional severity"
            },
            {
              "flags": [
                "--affected"
              ],
              "value": true,
              "choices": null,
              "help": "hosts or services affected, as far as known"
            },
            {
              "flags": [
                "--services"
              ],
              "value": true,
              "choices": null,
              "help": "catalog services affected, comma-separated (name or component:<name>)"
            },
            {
              "flags": [
                "--impact"
              ],
              "value": true,
              "choices": null,
              "help": "what is broken, for whom"
            },
            {
              "flags": [
                "--drill"
              ],
              "value": false,
              "choices": null,
              "help": "practice incident, tracked in the drill repository"
            },
            {
              "flags": [
                "--new"
              ],
              "value": false,
              "choices": null,
              "help": "open even though other incidents are open"
            },
            {
              "flags": [
                "--auto"
              ],
              "value": false,
              "choices": null,
              "help": "unattended triage: open in runner.tracker_repo (private), to be promoted"
            }
          ]
        },
        "promote": {
          "help": "make an unattended triage a real incident on the site's tracker",
          "options": [
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": ""
            },
            {
              "flags": [
                "--by"
              ],
              "value": true,
              "choices": null,
              "help": "the responder who asked for it"
            },
            {
              "flags": [
                "--title"
              ],
              "value": true,
              "choices": null,
              "help": "title for the public issue; default the triage's"
            }
          ]
        },
        "dismiss": {
          "help": "close an unattended triage that is not an incident",
          "options": [
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": ""
            },
            {
              "flags": [
                "--by"
              ],
              "value": true,
              "choices": null,
              "help": "the responder who judged it"
            },
            {
              "flags": [
                "--reason"
              ],
              "value": true,
              "choices": null,
              "help": ""
            }
          ]
        },
        "attach": {
          "help": "adopt an existing tracking issue",
          "options": [
            {
              "flags": [
                "--reopen"
              ],
              "value": false,
              "choices": null,
              "help": "reopen it if it is resolved (recorded in the timeline)"
            }
          ]
        },
        "status": {
          "help": "show an incident's local state",
          "options": [
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": ""
            }
          ]
        },
        "set": {
          "help": "edit facts in the issue body",
          "options": [
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": ""
            },
            {
              "flags": [
                "--severity"
              ],
              "value": true,
              "choices": [
                "P1",
                "P2",
                "P3",
                "P4"
              ],
              "help": ""
            },
            {
              "flags": [
                "--final"
              ],
              "value": false,
              "choices": null,
              "help": "mark the severity final rather than provisional"
            },
            {
              "flags": [
                "--phase"
              ],
              "value": true,
              "choices": [
                "Establishing picture",
                "Diagnosing",
                "Mitigating",
                "Verifying",
                "Resolved"
              ],
              "help": ""
            },
            {
              "flags": [
                "--affected"
              ],
              "value": true,
              "choices": null,
              "help": ""
            },
            {
              "flags": [
                "--services"
              ],
              "value": true,
              "choices": null,
              "help": "catalog services affected, comma-separated; replaces the list"
            },
            {
              "flags": [
                "--impact"
              ],
              "value": true,
              "choices": null,
              "help": ""
            },
            {
              "flags": [
                "--runbook"
              ],
              "value": true,
              "choices": null,
              "help": ""
            }
          ]
        },
        "gc": {
          "help": "clear local state of incidents whose audit log has merged",
          "options": [
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": "clear only this incident (repeatable); the default is every incident"
            },
            {
              "flags": [
                "--apply"
              ],
              "value": false,
              "choices": null,
              "help": "delete; the default is a dry run"
            },
            {
              "flags": [
                "--no-fetch"
              ],
              "value": false,
              "choices": null,
              "help": "do not fetch the audit repository first"
            },
            {
              "flags": [
                "--ignore-issue-state"
              ],
              "value": false,
              "choices": null,
              "help": "do not require the tracking issue to be closed"
            },
            {
              "flags": [
                "--token-days"
              ],
              "value": true,
              "choices": null,
              "help": "age at which an unused bind token is removed"
            },
            {
              "flags": [
                "--quiet"
              ],
              "value": false,
              "choices": null,
              "help": "print nothing"
            }
          ]
        },
        "close": {
          "help": "mark the incident resolved",
          "options": [
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": ""
            }
          ]
        }
      }
    },
    "timeline": {
      "script": "timeline.py",
      "help": "Write and read the timeline of an incident.",
      "options": [
        {
          "flags": [
            "--site"
          ],
          "value": true,
          "choices": null,
          "help": "site repository path"
        },
        {
          "flags": [
            "--incident"
          ],
          "value": true,
          "choices": null,
          "help": "<repo-alias>-<number>; default is the current incident"
        }
      ],
      "required": true,
      "commands": {
        "add": {
          "help": "post one typed entry",
          "options": [
            {
              "flags": [
                "--type"
              ],
              "value": true,
              "choices": [
                "discovery",
                "milestone",
                "action",
                "update",
                "handover",
                "summary",
                "decision"
              ],
              "help": ""
            },
            {
              "flags": [
                "--text"
              ],
              "value": true,
              "choices": null,
              "help": "entry text; read from stdin when omitted"
            },
            {
              "flags": [
                "--at"
              ],
              "value": true,
              "choices": null,
              "help": "when it happened, ISO 8601; default now"
            },
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": "<repo-alias>-<number>"
            }
          ]
        },
        "handover": {
          "help": "post a handover entry",
          "options": [
            {
              "flags": [
                "--state"
              ],
              "value": true,
              "choices": null,
              "help": "State"
            },
            {
              "flags": [
                "--tried"
              ],
              "value": true,
              "choices": null,
              "help": "Tried"
            },
            {
              "flags": [
                "--hypotheses"
              ],
              "value": true,
              "choices": null,
              "help": "Open hypotheses"
            },
            {
              "flags": [
                "--next"
              ],
              "value": true,
              "choices": null,
              "help": "Next step"
            },
            {
              "flags": [
                "--holder"
              ],
              "value": true,
              "choices": null,
              "help": "Now with"
            },
            {
              "flags": [
                "--at"
              ],
              "value": true,
              "choices": null,
              "help": "ISO 8601; default now"
            },
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": "<repo-alias>-<number>"
            }
          ]
        },
        "list": {
          "help": "print entries as JSON",
          "options": [
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": "<repo-alias>-<number>"
            }
          ]
        },
        "due": {
          "help": "is a status update due?",
          "options": [
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": "<repo-alias>-<number>"
            }
          ]
        },
        "export": {
          "help": "render the timeline as markdown",
          "options": [
            {
              "flags": [
                "--out"
              ],
              "value": true,
              "choices": null,
              "help": "write to this file instead of stdout"
            },
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": "<repo-alias>-<number>"
            }
          ]
        }
      }
    },
    "audit": {
      "script": "audit.py",
      "help": "Work with the audit log of an incident.",
      "options": [
        {
          "flags": [
            "--site"
          ],
          "value": true,
          "choices": null,
          "help": "site repository path"
        },
        {
          "flags": [
            "--incident"
          ],
          "value": true,
          "choices": null,
          "help": "<repo-alias>-<number>; default is the current incident"
        }
      ],
      "required": true,
      "commands": {
        "record": {
          "help": "add an explicit record",
          "options": [
            {
              "flags": [
                "--kind"
              ],
              "value": true,
              "choices": [
                "approval",
                "denial",
                "decision",
                "command",
                "note"
              ],
              "help": ""
            },
            {
              "flags": [
                "--text"
              ],
              "value": true,
              "choices": null,
              "help": "what was decided, approved or done, and why"
            },
            {
              "flags": [
                "--command"
              ],
              "value": true,
              "choices": null,
              "help": "the exact command this record is about"
            },
            {
              "flags": [
                "--approver"
              ],
              "value": true,
              "choices": null,
              "help": "who approved or denied"
            },
            {
              "flags": [
                "--agent"
              ],
              "value": true,
              "choices": null,
              "help": "the agent writing this record, if it has no hook (codex, opencode, ...)"
            },
            {
              "flags": [
                "--model"
              ],
              "value": true,
              "choices": null,
              "help": "the model it runs, as provider/model"
            },
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": "<repo-alias>-<number>"
            }
          ]
        },
        "show": {
          "help": "where the log is and what it holds",
          "options": [
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": "<repo-alias>-<number>"
            }
          ]
        },
        "verify": {
          "help": "check the hash chain; list attempts that never completed",
          "options": [
            {
              "flags": [
                "--check-anchors"
              ],
              "value": false,
              "choices": null,
              "help": "also compare with head hashes pinned in the timeline (needs gh)"
            },
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": "<repo-alias>-<number>"
            }
          ]
        },
        "commit": {
          "help": "commit the log to the audit repository and stop capture",
          "options": [
            {
              "flags": [
                "--no-pr"
              ],
              "value": false,
              "choices": null,
              "help": "push the branch but do not open a pull request"
            },
            {
              "flags": [
                "--offline"
              ],
              "value": false,
              "choices": null,
              "help": "skip the comparison with the timeline's pinned hashes"
            },
            {
              "flags": [
                "--amend"
              ],
              "value": false,
              "choices": null,
              "help": "the log changed since it was committed: push it to the same branch"
            },
            {
              "flags": [
                "--unresolved"
              ],
              "value": false,
              "choices": null,
              "help": "commit the log of an incident that is not resolved (ends capture; not allowed from chat)"
            },
            {
              "flags": [
                "--incident"
              ],
              "value": true,
              "choices": null,
              "help": "<repo-alias>-<number>"
            }
          ]
        }
      }
